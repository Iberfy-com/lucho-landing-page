---
import Home from "../components/Home/Home.astro";
import Layout from "../layouts/Layout.astro";

const canonicalUrl = "https://www.iberfy.com";
const title = "Iberfy | Automatización Empresarial y Servicios Digitales";
const description =
    "Iberfy - Expertos en automatización empresarial, atención al cliente, prospección B2B y desarrollo web. Tu negocio online funcionando 24/7.";
---

<Layout canonical={canonicalUrl} title={title} description={description}>
    <Home />
</Layout>

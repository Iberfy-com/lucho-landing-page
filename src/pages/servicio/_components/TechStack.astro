---
interface Props {
    items: {
        src: string;
        alt: string;
    }[];
}

const { items } = Astro.props;
---

<div class="container-tech">
    <h2>STACK TECNOLÓGICO</h2>
    <div>
        {items.map((item) => <img src={item.src} alt={item.alt} />)}
    </div>
</div>

<style>
    .container-tech {
        max-width: 1200px;
        margin: 6rem auto;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
        border-radius: 24px;
        box-shadow:
            0 25px 50px rgba(59, 130, 246, 0.1),
            0 10px 25px rgba(0, 0, 0, 0.05);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .container-tech::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #2196f3, #21cbf3, #00bcd4, #2196f3);
        background-size: 300% 100%;
        animation: techGradient 4s ease-in-out infinite;
    }

    @keyframes techGradient {
        0%,
        100% {
            background-position: 0% 0%;
        }
        50% {
            background-position: 100% 0%;
        }
    }

    .container-tech h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 3rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        position: relative;
    }

    .container-tech h2::after {
        content: "";
        position: absolute;
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 4px;
        background: linear-gradient(90deg, #2196f3, #21cbf3);
        border-radius: 2px;
    }

    .container-tech > div {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 2.5rem;
        align-items: center;
        justify-items: center;
    }

    .container-tech img {
        max-width: 140px;
        max-height: 80px;
        object-fit: contain;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        filter: grayscale(20%) opacity(0.8);
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        box-shadow:
            0 8px 25px rgba(59, 130, 246, 0.08),
            0 3px 10px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(59, 130, 246, 0.1);
    }

    .container-tech img:hover {
        transform: translateY(-8px) scale(1.05);
        filter: grayscale(0%) opacity(1);
        box-shadow:
            0 15px 35px rgba(59, 130, 246, 0.15),
            0 8px 20px rgba(0, 0, 0, 0.1);
        border-color: rgba(59, 130, 246, 0.2);
    }

    @media (max-width: 768px) {
        .container-tech {
            margin: 3rem 1rem;
            padding: 3rem 1.5rem;
        }

        .container-tech > div {
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1.5rem;
        }

        .container-tech img {
            max-width: 120px;
            max-height: 70px;
            padding: 1rem;
        }
    }

    @media (max-width: 480px) {
        .container-tech > div {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .container-tech img {
            max-width: 100px;
            max-height: 60px;
            padding: 0.8rem;
        }
    }
</style>

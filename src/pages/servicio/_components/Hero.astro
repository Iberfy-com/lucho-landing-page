---
interface Props {
    heroVideoUrl: string;
    heroVideoUrlMobile: string;
    title: string;
    subtitle: string;
}
const { heroVideoUrl, heroVideoUrlMobile, title, subtitle } = Astro.props;
---

<div id="section-hero"></div>
<div class="container-hero">
    <div class="container-hero-head">
        <div class="container-hero-head-mask"></div>
        <video muted autoplay loop class="desktop">
            <source src={heroVideoUrl} type="video/webm" />
            Tu navegador no soporta el tag de video.
        </video>
        <video muted autoplay loop class="mobile">
            <source src={heroVideoUrlMobile} type="video/webm" />
            Tu navegador no soporta el tag de video.
        </video>
        <h1>{title}</h1>
        <h2>{subtitle}</h2>
    </div>
</div>

<style>
    .container-hero-head {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        position: relative;
        max-height: 80vh;
        height: 100%;
        width: 100%;
        overflow: hidden;
        padding: 2rem;
        padding-top: 130px;

        @media (min-width: 768px) {
            padding-top: 200px;
        }
    }

    .container-hero-head video {
        filter: blur(5px);
        max-width: 100%;
        max-height: 100%;
        overflow: hidden;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.8;
        z-index: 1;
    }

    .container-hero-head-mask {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.2);
        z-index: 2;
    }

    .container-hero-head h1 {
        z-index: 5;
        position: relative;
        z-index: 2;
        color: white;
        font-size: 48px;
        font-weight: 800;
        text-align: center;
        margin-bottom: 1.5rem;
        line-height: 1.1;
        letter-spacing: 4.5px;
        text-shadow: 0px 8px 5px #00000020;
        max-width: 50%;

        @media (min-width: 768px) {
            font-size: 72px;
        }
    }
    .container-hero-head h2 {
        position: relative;
        z-index: 5;
        color: #fff;
        font-size: 20px;
        text-shadow: 0px 8px 5px #00000020;
        font-weight: 600;
        text-align: center;
        margin-bottom: 2rem;

        @media (min-width: 768px) {
            font-size: 28px;
        }
    }

    .desktop {
        display: none;
    }
    @media (min-width: 1024px) {
        .desktop {
            display: block;
        }
        .mobile {
            display: none;
        }
    }
</style>

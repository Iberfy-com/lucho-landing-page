---
interface Props {
    urlVideo: string;
    titleVideo: string;
}

const { urlVideo, titleVideo } = Astro.props;
---

<div class="container-video-section">
    <h3>Como funciona</h3>
    <div class="video-wrapper">
        <iframe
            src={urlVideo}
            title={titleVideo}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
        >
        </iframe>
    </div>
</div>

<style>
    .container-video-section {
        max-width: 1200px;
        margin: 6rem auto;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
        border-radius: 24px;
        box-shadow:
            0 25px 50px rgba(59, 130, 246, 0.1),
            0 10px 25px rgba(0, 0, 0, 0.05);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .container-video-section::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #2196f3, #21cbf3, #2196f3);
        background-size: 300% 100%;
        animation: videoGradient 3s ease-in-out infinite;
    }

    @keyframes videoGradient {
        0%,
        100% {
            background-position: 0% 0%;
        }
        50% {
            background-position: 100% 0%;
        }
    }

    .container-video-section h3 {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        position: relative;
        line-height: 1.2;
        margin-bottom: 50px;
    }

    .container-video-section h3::after {
        content: "";
        position: absolute;
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, #2196f3, #21cbf3);
        border-radius: 2px;
    }

    .container-video-section .video-subtitle {
        font-size: clamp(1rem, 2vw, 1.3rem);
        color: #64748b;
        margin-bottom: 3rem;
        font-weight: 400;
        line-height: 1.6;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .video-wrapper {
        position: relative;
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        background: #000;
        border-radius: 16px;
        overflow: hidden;
        box-shadow:
            0 20px 40px rgba(0, 0, 0, 0.2),
            0 10px 25px rgba(0, 0, 0, 0.1);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .video-wrapper:hover {
        transform: translateY(-5px);
        box-shadow:
            0 30px 60px rgba(0, 0, 0, 0.25),
            0 15px 35px rgba(0, 0, 0, 0.15);
    }

    .video-wrapper iframe {
        width: 100%;
        height: 450px;
        display: block;
        border: none;
    }

    @media (max-width: 768px) {
        .container-video-section {
            margin: 3rem 1rem;
            padding: 3rem 1.5rem;
        }

        .container-video-section h3 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .container-video-section .video-subtitle {
            font-size: 1rem;
            margin-bottom: 2rem;
        }

        .video-wrapper iframe {
            height: 250px;
        }
    }

    @media (max-width: 480px) {
        .container-video-section {
            padding: 2rem 1rem;
        }

        .container-video-section h3 {
            font-size: 1.5rem;
        }

        .video-wrapper iframe {
            height: 200px;
        }
    }
</style>

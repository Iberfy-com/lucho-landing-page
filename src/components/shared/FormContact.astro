<div id="section-contact"></div>
<section class="contact position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xxl-6 col-xl-6 col-lg-6 col-12">
                <h5 class="fs-7 section-subheading text-uppercase fw-500">
                    Contactanos ahora
                </h5>
                <div class="fs-2 section-heading text-uppercase fw-bold">
                    ¿Tienes algún problema? <br />
                    Estamos aquí para ayudarte.
                </div>
            </div>
            <div class="col-xxl-6 col-xl-6 col-lg-6 col-12">
                <form id="form-contacto">
                    <div class="row">
                        <div
                            class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12"
                        >
                            <div class="form-group">
                                <label
                                    class="form-label text-uppercase fs-6 mb-3"
                                    >Nombre completo</label
                                >
                                <input
                                    type="text"
                                    id="contact-name"
                                    class="form-control border-0"
                                    placeholder="Ingresa tu nombre"
                                />
                            </div>
                        </div>
                        <div
                            class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12"
                        >
                            <div class="form-group">
                                <label class="form-label text-uppercase mb-3"
                                    >Correo electrónico</label
                                >
                                <input
                                    type="email"
                                    id="contact-email"
                                    class="form-control border-0"
                                    placeholder="Ingresa tu correo electrónico"
                                />
                            </div>
                        </div>
                        <div
                            class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12"
                        >
                            <div class="form-group">
                                <label
                                    class="form-label text-uppercase fs-6 mb-3"
                                    >Teléfono</label
                                >
                                <input
                                    type="text"
                                    id="contact-phone"
                                    class="form-control border-0"
                                    placeholder="Ingresa tu número de teléfono"
                                />
                            </div>
                        </div>
                        <div
                            class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12"
                        >
                            <div class="form-group">
                                <label class="form-label text-uppercase mb-3"
                                    >Asunto</label
                                >
                                <select
                                    id="contact-subject"
                                    class="form-control border-0"
                                >
                                    <option value="general"> General </option>
                                    <option value="atencion-al-cliente">
                                        Atención al cliente
                                    </option>
                                    <option value="b2b">
                                        Base de datos b2b
                                    </option>
                                    <option value="prospeccion-telefonica">
                                        Prospección telefónica
                                    </option>
                                    <option value="email-marketing">
                                        Email Marketing
                                    </option>
                                    <option value="linkedin">
                                        Automatización linkedin
                                    </option>
                                    <option value="web"> Sitio web </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xxl-12 col-xl-12 col-12">
                            <div
                                class="mb-xxl-4 mb-xl-4 mb-lg-4 mb-md-4 mb-sm-3 mb-3"
                            >
                                <label class="form-label text-uppercase mb-3"
                                    >Mensaje</label
                                >
                                <textarea
                                    id="contact-message"
                                    class="form-control border-0"
                                    placeholder="Ingrese su mensaje"></textarea>
                            </div>
                        </div>
                        <div
                            class="col-xxl-8 col-xl-8 col-lg-8 col-md-8 col-sm-12 col-12"
                        >
                            <!-- <div class="g-recaptcha" data-sitekey="6Lel4Z4UAAAAAOa8LO1Q9mqKRUiMYl_00o5mXJrR"></div>-->
                        </div>
                        <div
                            class="col-xxl-4 col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12 d-flex justify-content-end"
                        >
                            <button
                                id="btn-form-contacto"
                                class="btn btn-primary btn-hover-secondery text-capitalize mt-2 w-100"
                            >
                                enviar
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
